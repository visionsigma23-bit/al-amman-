rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'visionsigma23@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOptionalString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isStringList(listVal, maxItems) {
      return listVal is list && listVal.size() <= maxItems && (listVal.size() == 0 || listVal[0] is string);
    }

    function isMapList(listVal, maxItems) {
      return listVal is list && listVal.size() <= maxItems && (listVal.size() == 0 || listVal[0] is map);
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidProject(data) {
      return data.keys().hasAll([
          'name', 'slug', 'location', 'category', 'status',
          'shortDescription', 'fullDescription', 'coverImage',
          'galleryImages', 'amenities', 'plotSizes',
          'featured', 'published', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'slug', 'location', 'category', 'status',
          'shortDescription', 'fullDescription', 'coverImage',
          'galleryImages', 'amenities', 'plotSizes',
          'propertyCategories', 'developmentHighlights', 'investmentInfo',
          'locationNote', 'mapEmbedUrl', 'faqs', 'contactPhone', 'contactEmail',
          'featured', 'published', 'displayOrder', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 140
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 120 && data.slug.matches('^[a-z0-9]+(?:-[a-z0-9]+)*$')
        && data.location is string && data.location.size() >= 2 && data.location.size() <= 180
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
        && data.status is string && data.status.size() >= 2 && data.status.size() <= 60
        && data.shortDescription is string && data.shortDescription.size() >= 10 && data.shortDescription.size() <= 360
        && data.fullDescription is string && data.fullDescription.size() >= 20 && data.fullDescription.size() <= 6000
        && data.coverImage is string && data.coverImage.size() >= 5 && data.coverImage.size() <= 1000
        && isStringList(data.galleryImages, 12)
        && isStringList(data.amenities, 24)
        && isStringList(data.plotSizes, 16)
        && (!('propertyCategories' in data) || isMapList(data.propertyCategories, 8))
        && (!('developmentHighlights' in data) || isStringList(data.developmentHighlights, 12))
        && isOptionalString(data, 'investmentInfo', 3000)
        && isOptionalString(data, 'locationNote', 1200)
        && isOptionalString(data, 'mapEmbedUrl', 1000)
        && (!('faqs' in data) || isMapList(data.faqs, 12))
        && isOptionalString(data, 'contactPhone', 40)
        && isOptionalString(data, 'contactEmail', 120)
        && data.featured is bool
        && data.published is bool
        && (!('displayOrder' in data) || data.displayOrder is number)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInquiry(data) {
      return data.keys().hasAll([
          'name', 'phone', 'email', 'interestedProject',
          'message', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'phone', 'email', 'interestedProject',
          'message', 'sourcePage', 'status', 'adminNotes',
          'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 40
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.interestedProject is string && data.interestedProject.size() >= 2 && data.interestedProject.size() <= 160
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 3000
        && isOptionalString(data, 'sourcePage', 120)
        && data.status in ['new', 'contacted', 'completed', 'archived']
        && isOptionalString(data, 'adminNotes', 2000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteContent(data) {
      return data.keys().hasAll([
          'companyName', 'tagline', 'heroHeadline', 'heroSubtitle',
          'whatsappNumber', 'contactPhone', 'contactEmail', 'officeAddress',
          'stats', 'testimonials', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'companyName', 'companyLogoUrl', 'tagline', 'heroHeadline', 'heroSubtitle',
          'aboutPreviewTitle', 'aboutPreviewBody', 'aboutFullStory',
          'whatsappNumber', 'contactPhone', 'contactEmail', 'officeAddress',
          'officeHours', 'socialLinks', 'stats', 'testimonials',
          'ctaHeadline', 'ctaSubtext', 'updatedAt'
        ])
        && data.companyName is string && data.companyName.size() >= 2 && data.companyName.size() <= 100
        && isOptionalString(data, 'companyLogoUrl', 1000)
        && data.tagline is string && data.tagline.size() >= 2 && data.tagline.size() <= 160
        && data.heroHeadline is string && data.heroHeadline.size() >= 4 && data.heroHeadline.size() <= 160
        && data.heroSubtitle is string && data.heroSubtitle.size() >= 10 && data.heroSubtitle.size() <= 500
        && isOptionalString(data, 'aboutPreviewTitle', 180)
        && isOptionalString(data, 'aboutPreviewBody', 2000)
        && isOptionalString(data, 'aboutFullStory', 6000)
        && data.whatsappNumber is string && data.whatsappNumber.size() >= 6 && data.whatsappNumber.size() <= 30
        && data.contactPhone is string && data.contactPhone.size() <= 40
        && data.contactEmail is string && data.contactEmail.size() <= 120
        && data.officeAddress is string && data.officeAddress.size() <= 400
        && isOptionalString(data, 'officeHours', 160)
        && (!('socialLinks' in data) || (
          data.socialLinks is map &&
          data.socialLinks.keys().hasOnly(['facebook', 'instagram', 'linkedin', 'youtube'])
        ))
        && isMapList(data.stats, 6)
        && isMapList(data.testimonials, 6)
        && isOptionalString(data, 'ctaHeadline', 200)
        && isOptionalString(data, 'ctaSubtext', 400)
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && isOptionalString(data, 'displayName', 120)
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    // Startup connection check document
    match /test/connection {
      allow get: if true;
    }

    // Real estate projects: published projects are public; all operations guarded for admins
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (existing().published == true || isAdmin());
      allow list: if existing().published == true || isAdmin();
      allow create: if isAdmin()
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'slug', 'location', 'category', 'status',
          'shortDescription', 'fullDescription', 'coverImage',
          'galleryImages', 'amenities', 'plotSizes',
          'propertyCategories', 'developmentHighlights', 'investmentInfo',
          'locationNote', 'mapEmbedUrl', 'faqs', 'contactPhone', 'contactEmail',
          'featured', 'published', 'displayOrder', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(projectId);
    }

    // Customer inquiries: public submission with strict validation; PII strictly isolated to admins
    match /inquiries/{inquiryId} {
      allow get: if isAdmin() && isValidId(inquiryId);
      allow list: if isAdmin();
      allow create: if isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().status == 'new'
        && !('adminNotes' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(inquiryId)
        && isValidInquiry(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(inquiryId);
    }

    // Website content & WhatsApp settings
    match /site_content/{contentId} {
      allow get: if isValidId(contentId);
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(contentId)
        && isValidSiteContent(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(contentId)
        && isValidSiteContent(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'companyName', 'companyLogoUrl', 'tagline', 'heroHeadline', 'heroSubtitle',
          'aboutPreviewTitle', 'aboutPreviewBody', 'aboutFullStory',
          'whatsappNumber', 'contactPhone', 'contactEmail', 'officeAddress',
          'officeHours', 'socialLinks', 'stats', 'testimonials',
          'ctaHeadline', 'ctaSubtext', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Authorized admin directory
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isAdmin() || (isVerifiedUser() && request.auth.uid == adminId));
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(adminId)
        && isValidAdminUser(incoming())
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(adminId)
        && isValidAdminUser(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      allow delete: if isAdmin() && isValidId(adminId) && adminId != request.auth.uid;
    }
  }
}
